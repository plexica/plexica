{
  "name": "@plexica/plugin-crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"vite dev --port 4001\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:ui": "vite dev --port 4001",
    "build": "pnpm build:backend && pnpm build:ui",
    "build:backend": "tsc",
    "build:ui": "NODE_ENV=production vite build",
    "preview:ui": "vite preview --port 4001 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "start": "node dist/index.js",
    "migration:apply": "echo 'Apply migrations via core API'"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@fastify/cors": "^11.0.0",
    "@plexica/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plexica/vite-plugin": "workspace:*",
    "@originjs/vite-plugin-federation": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
