{
  "name": "plexica",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "description": "Plexica v2 — Multi-tenant SaaS platform",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:lines": "bash scripts/check-authored-lines.sh",
    "test:line-gate": "bash scripts/check-authored-lines.test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-storybook": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
