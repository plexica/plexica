# ─────────────────────────────────────────────────────────────────────────────
# Plexica v2 — Environment Variables
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env — it contains real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=plexica
POSTGRES_USER=plexica
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://plexica:changeme@localhost:5432/plexica
# Development/test must explicitly disable TLS. Production requires verify-full.
PLUGIN_DB_SSL_MODE=disable
# Production-only absolute CA path mounted read-only into core and plugin runtimes.
# PLUGIN_DB_SSL_ROOT_CERT_PATH=/run/secrets/plexica/postgres-ca.crt
# Optional when a Docker plugin reaches PostgreSQL/Core through different hosts.
# PLUGIN_DB_HOST=postgres
# PLUGIN_DB_PORT=5432
# PLUGIN_DOCKER_NETWORK=plexica-production_default
# PLUGIN_CORE_API_URL=http://host.docker.internal:3001
# Required in production: 64 hexadecimal characters.
# PLUGIN_DB_ENCRYPTION_KEY=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_ADMIN_ORIGIN=http://localhost:3002
KEYCLOAK_API_AUDIENCE=plexica-api

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=storageadmin
STORAGE_SECRET_KEY=changeme
# FR-003 indirection: the storage server reads MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD; Compose maps them FROM the neutral STORAGE_* vars above.
# Our code, scripts, and CI never read MINIO_ROOT_* as interface variables.

# ── Redpanda (Kafka-compatible) ───────────────────────────────────────────────
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
KAFKA_BROKERS=localhost:19092
# Required in production. Generate unique 32-byte base64url key material.
# EVENT_KEY_ENCRYPTION_KEY=
# Required for plugin service credentials. Generate at least 32 random bytes.
# PLUGIN_CREDENTIAL_PEPPER=

# ── Mailpit (SMTP dev server) ─────────────────────────────────────────────────
SMTP_PORT=1025
SMTP_UI_PORT=8025
SMTP_HOST=localhost

# ── Notifications (ADR-035, features 006-01…006-05) ───────────────────────────
# SSE heartbeat keepalive interval (ms). Default 20000.
NOTIFICATION_SSE_HEARTBEAT_MS=20000
# SSE connection-establishment rate limit (max connects per user per minute).
# Default 10 (ADR-035). Raise (e.g. 100) in E2E/CI where a shared test user
# re-establishes the stream across specs inside one 60s window.
NOTIFICATION_SSE_CONNECT_RATE_LIMIT=10
# Per-user open SSE connection cap (oldest evicted). Default 5.
NOTIFICATION_SSE_MAX_CONNECTIONS_PER_USER=5
# Defense-in-depth consumer cap: max notification events per user per minute. Default 100.
NOTIFICATION_CONSUMER_CAP_PER_MIN=100
# Emission cap: max notifications per plugin per user per minute (Redis). Default 10.
NOTIFICATION_EMIT_RATE_LIMIT_PER_PLUGIN_USER_PER_MIN=10
# Email queue retry worker (006-03): max attempts and base backoff (ms). Defaults 3 / 1000.
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_BACKOFF_MS=1000
NOTIFICATION_EMAIL_WORKER_INTERVAL_MS=1000

# ── Prometheus / metrics (ADR-036, features 006-17…006-20) ─────────────────────
# Path served by the /metrics route (public opt-in, root instance). Default /metrics.
PROMETHEUS_METRICS_PATH=/metrics
# Gauge refresh interval (ms). Default 30000 — scrape only serializes the registry.
PROMETHEUS_GAUGE_INTERVAL_MS=30000
# Optional bearer token guarding /metrics when set; open by default. NO default secret.
# METRICS_TOKEN=

# ── OpenTelemetry (feature 006-19, deferred to Sprint 7) ───────────────────────
# Feature-flagged off by default; no @opentelemetry/* dependencies land this sprint.
OTEL_TRACING_ENABLED=false

# ── Keycloak account console (feature 006-14) ──────────────────────────────────
# Per-realm account console URL pattern; {realm} is substituted at runtime.
KEYCLOAK_ACCOUNT_URL_PATTERN=http://localhost:8080/realms/{realm}/account/

# ── Loki + Grafana (log aggregation, ADR-022 Decision 3) ──────────────────────
LOKI_PORT=3100
LOKI_URL=http://localhost:3100
GRAFANA_PORT=3301
GRAFANA_URL=http://localhost:3301
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Higher limit for dev/E2E to avoid flaky rate-limit tests (default 30)
RATE_LIMIT_RESOLVE_MAX=100

# ── E2E Testing (Playwright) ──────────────────────────────────────────────────
PLAYWRIGHT_API_URL=http://localhost:3001
# Must match RATE_LIMIT_RESOLVE_MAX so the test sends the right request count
PLAYWRIGHT_RATE_LIMIT_RESOLVE_MAX=100

# ── GitHub (MCP integration) ──────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_...
