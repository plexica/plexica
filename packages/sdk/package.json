{
  "name": "@plexica/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./dev": {
      "types": "./dev/index.ts",
      "development": "./dev/index.ts",
      "import": "./dist/dev/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "dev",
    "!dist/*.tsbuildinfo",
    "!dist/*.tsbuildinfo.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:coverage": "vitest run --coverage --coverage.reporter=cobertura --coverage.reportsDirectory=coverage/unit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plexica/plexica.git",
    "directory": "packages/sdk"
  }
}
