{
  "name": "@plexica/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./jwt": "./src/jwt.ts",
    "./keycloak-client": "./src/keycloak-client.ts",
    "./api-client": "./src/api-client.ts",
    "./env-guard": "./src/env-guard.ts",
    "./auth-store": "./src/auth-store.ts",
    "./auth-flow": "./src/auth-flow.ts",
    "./auth-epoch": "./src/auth-epoch.ts",
    "./authorization-request": "./src/authorization-request.ts",
    "./pkce": "./src/pkce.ts",
