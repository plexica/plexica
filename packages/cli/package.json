{
  "name": "@plexica/create-plexica-plugin",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "create-plexica-plugin": "./dist/bin/create-plexica-plugin.js"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "!dist/*.tsbuildinfo.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:coverage": "vitest run --coverage --coverage.reporter=cobertura --coverage.reportsDirectory=coverage/unit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plexica/plexica.git",
    "directory": "packages/cli"
  }
}
